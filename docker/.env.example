# Copy to docker/.env and adjust.

# Required. Generate one with: openssl rand -base64 42
SUPERSET_SECRET_KEY=

SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_PORT=8088
# Who can reach it. Use 0.0.0.0 for the local network only with a real admin password.
SUPERSET_BIND=127.0.0.1

# DuckDB file built by the pipeline, relative to this folder.
ELECTIONS_DB=../elections.duckdb
